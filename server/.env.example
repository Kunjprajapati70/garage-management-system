NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/garage_ms
JWT_ACCESS_SECRET=replace-with-a-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-a-long-random-refresh-secret
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# JWT_SECRET and JWT_EXPIRES_IN are accepted as aliases of the access token settings above.
JWT_SECRET=
JWT_EXPIRES_IN=
# Local: http://localhost:5173
# Railway: the Vercel site, for example https://your-app.vercel.app
CLIENT_URL=http://localhost:5173

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=Apex Motors
SMTP_FROM_EMAIL=noreply@example.com

SEED_ADMIN_EMAIL=admin@apexmotors.local
SEED_ADMIN_PASSWORD=ChangeMe_Admin_123
SEED_ADMIN_NAME=Apex Admin
SEED_USER_PASSWORD=ChangeMe_User_123
